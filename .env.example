# Proxy 的 API key。留空 = 不驗證（只建議在本機這樣用）
PROXY_API_KEY=你的proxy-api-key

# 監聽 port（預設 3456）
# PORT=3456

# GitHub token 儲存路徑（預設 ./.credentials.json）
# CREDENTIALS_PATH=/data/.credentials.json

# 伺服器端預設思考檔位：low / medium / high / xhigh / max
# 留空 = 不主動開啟（由 client 決定）。client 明確指定時一律以 client 為準。
# 只對支援 reasoning_effort 的模型生效（sonnet-5、opus-4.6/4.7/4.8、sonnet-4.6）。
# COPILOT_THINKING_EFFORT=high
